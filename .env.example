# Shared local-development defaults.
# Copy this file to .env before starting Docker Compose.
# Never commit .env or real credentials.

POSTGRES_DB=incident_response
POSTGRES_USER=incident_response
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2
WEBHOOK_SECRET_LOCAL_SIMULATOR=

CONTROL_PLANE_PORT=8080
INTELLIGENCE_SERVICE_PORT=8000
WEB_PORT=3000

BUILD_VERSION=local
